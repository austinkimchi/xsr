+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package componentprofile
+
+import (
+	"testing"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+func TestObserveAccumulatesExactTotals(t *testing.T) {
+	stage := StageBM25Native
+	beforeCount := globalAggregates[stage].count.Load()
+	beforeTotal := globalAggregates[stage].totalNS.Load()
+
+	Observe(stage, 1500*time.Nanosecond)
+	Observe(stage, 2500*time.Nanosecond)
+
+	if got := globalAggregates[stage].count.Load() - beforeCount; got != 2 {
+		t.Fatalf("count delta = %d, want 2", got)
+	}
+	if got := globalAggregates[stage].totalNS.Load() - beforeTotal; got != 4000 {
+		t.Fatalf("duration delta = %d ns, want 4000 ns", got)
+	}
+}
+
+func TestObserveExtProcSendExcludesOtherMessageTypes(t *testing.T) {
+	stage := StageExtProcSend
+	beforeCount := globalAggregates[stage].count.Load()
+
+	ObserveExtProcSend("request header", time.Now())
+
+	if got := globalAggregates[stage].count.Load() - beforeCount; got != 0 {
+		t.Fatalf("count delta = %d, want 0", got)
+	}
+}
+
+func TestCollectorExportsEveryStageAsCounters(t *testing.T) {
+	registry := prometheus.NewPedanticRegistry()
+	registry.MustRegister(newCollector())
+	families, err := registry.Gather()
+	if err != nil {
+		t.Fatalf("gather: %v", err)
+	}
+
+	wantNames := map[string]bool{
+		"vsr_component_profile_events_total":               false,
+		"vsr_component_profile_duration_nanoseconds_total": false,
+	}
+	for _, family := range families {
+		if _, ok := wantNames[family.GetName()]; !ok {
+			continue
+		}
+		wantNames[family.GetName()] = true
+		if got := len(family.Metric); got != int(stageCount) {
+			t.Fatalf("metric count for %s = %d, want %d", family.GetName(), got, stageCount)
+		}
+	}
+	for name, seen := range wantNames {
+		if !seen {
+			t.Errorf("metric family %s was not exported", name)
+		}
+	}
+}
