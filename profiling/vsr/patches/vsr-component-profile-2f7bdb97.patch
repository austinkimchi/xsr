@@ -0,0 +1,111 @@
+//go:build vsr_profile_components
+
+/*
+Copyright 2026 vLLM Semantic Router.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package componentprofile
+
+import (
+	"sync/atomic"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+type aggregate struct {
+	count   atomic.Uint64
+	totalNS atomic.Uint64
+}
+
+type collector struct {
+	eventsDesc   *prometheus.Desc
+	durationDesc *prometheus.Desc
+}
+
+var globalAggregates [stageCount]aggregate
+
+func newCollector() *collector {
+	return &collector{
+		eventsDesc: prometheus.NewDesc(
+			"vsr_component_profile_events_total",
+			"Number of completed directly timed VSR component events.",
+			[]string{"stage"},
+			nil,
+		),
+		durationDesc: prometheus.NewDesc(
+			"vsr_component_profile_duration_nanoseconds_total",
+			"Cumulative duration in nanoseconds for directly timed VSR component events.",
+			[]string{"stage"},
+			nil,
+		),
+	}
+}
+
+func (c *collector) Describe(ch chan<- *prometheus.Desc) {
+	ch <- c.eventsDesc
+	ch <- c.durationDesc
+}
+
+func (c *collector) Collect(ch chan<- prometheus.Metric) {
+	for stage := Stage(0); stage < stageCount; stage++ {
+		aggregate := &globalAggregates[stage]
+		name := stageNames[stage]
+		ch <- prometheus.MustNewConstMetric(
+			c.eventsDesc,
+			prometheus.CounterValue,
+			float64(aggregate.count.Load()),
+			name,
+		)
+		ch <- prometheus.MustNewConstMetric(
+			c.durationDesc,
+			prometheus.CounterValue,
+			float64(aggregate.totalNS.Load()),
+			name,
+		)
+	}
+}
+
+// Start records a monotonic timer start for a directly instrumented boundary.
+func Start() time.Time {
+	return time.Now()
+}
+
+// Observe adds one completed event with a duration already measured by the caller.
+func Observe(stage Stage, duration time.Duration) {
+	if stage >= stageCount || duration < 0 {
+		return
+	}
+	aggregate := &globalAggregates[stage]
+	aggregate.totalNS.Add(uint64(duration.Nanoseconds()))
+	aggregate.count.Add(1)
+}
+
+// ObserveSince adds one completed event ending at this call.
+func ObserveSince(stage Stage, start time.Time) {
+	Observe(stage, time.Since(start))
+}
+
+// ObserveExtProcSend records request-body response submission only. It does not
+// claim to measure delivery to Envoy or subsequent upstream forwarding.
+func ObserveExtProcSend(messageType string, start time.Time) {
+	if messageType == "request body" {
+		ObserveSince(StageExtProcSend, start)
+	}
+}
+
+func init() {
+	prometheus.MustRegister(newCollector())
+}
